# --- Externes (tous optionnels : l'app fonctionne en mode stub sans eux) ---

# Anthropic (Claude) — utilisé côté serveur uniquement pour générer la réponse IA.
# Tant que la clé n'est pas branchée, src/lib/ai.ts retourne un texte local.
ANTHROPIC_API_KEY=
# Optionnel : modèle (défaut: claude-opus-5-5 ; économique: claude-haiku-4-5).
ANTHROPIC_MODEL=

# CRM (GoHighLevel) — webhook entrant qui reçoit le lead. Si vide,
# src/lib/crm.ts logue le payload côté serveur au lieu de l'envoyer (pour ne
# jamais polluer le CRM de production pendant le dev/les tests).
#
# Michel utilise déjà ce webhook en production sur refinancement-michel-
# turgeon.vercel.app et taux120jours-michel-turgeon (même courtier, même
# CRM) — coller la même valeur ici (voir .env.example de ces deux projets,
# ou la config Vercel) une fois ce projet validé, pour que les trois outils
# tombent dans le même pipeline de leads.
CRM_WEBHOOK_URL=
